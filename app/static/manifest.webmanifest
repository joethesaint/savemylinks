{
  "name": "SaveMyLinks",
  "short_name": "SaveMyLinks",
  "description": "Save any page in one move and find it again by its title, your note or its category.",
  "id": "../",
  "start_url": "../",
  "scope": "../",
  "display": "standalone",
  "background_color": "#eef2f1",
  "theme_color": "#2f6f7a",
  "icons": [
    { "src": "art/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "art/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "art/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "art/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "share_target": {
    "action": "../add.html",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "shortcuts": [
    { "name": "Save a link", "url": "../add.html", "icons": [{ "src": "art/icon-192.png", "sizes": "192x192" }] }
  ]
}
